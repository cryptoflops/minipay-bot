# MiniPayBot Environment Variables

# LLM Provider (required)
OPENAI_API_KEY=sk-...

# Agent Wallet -- private key for the bot's Celo wallet (server-side only, never expose to client)
# Fund this wallet with cUSD on Celo mainnet for fee-abstracted transactions
AGENT_PRIVATE_KEY=0x...
NEXT_PUBLIC_AGENT_ADDRESS=0x...


# Celo RPC
CELO_RPC_URL=https://forno.celo.org

# Reown (WalletConnect) project ID for wallet connect on the frontend
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Thirdweb -- secret key for x402 micropayment settlement (server-side only)
THIRDWEB_SECRET_KEY=

# AgentActionLog contract address on Celo mainnet
AGENT_ACTION_LOG_ADDRESS=

# ElizaOS Remote Server
ELIZA_BASE_URL=http://18.195.127.114:3000
ELIZA_AGENT_ID=7295663b-da7d-0086-8480-f5f429cb5d26

